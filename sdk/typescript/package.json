{
  "name": "@offshoot-db/client",
  "version": "0.1.0",
  "description": "TypeScript client for offshoot: branchable SQLite for agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offshoot-db/offshoot.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/offshoot-db/offshoot#readme",
  "bugs": {
    "url": "https://github.com/offshoot-db/offshoot/issues"
  },
  "keywords": [
    "sqlite",
    "branching",
    "agents",
    "eval",
    "testing",
    "checkpoint"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test test-dist/test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
